### Register
POST http://localhost:3000/api/v1/register
Content-Type: application/json

{
  "name": "Ben",
  "email": "ben@example.com",
  "password": "secret123"
}

### Log in as Ben
POST http://localhost:3000/api/v1/login
Content-Type: application/json

{
  "email": "ben@example.com",
  "password": "secret123"
}

> {%
  client.global.set("token", response.body.token);
%}

### Log in as Ana
POST http://localhost:3000/api/v1/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "password"
}

> {%
  client.global.set("token", response.body.token);
%}

### Me
GET http://localhost:3000/api/v1/me
Authorization: Bearer {{token}}

### Refresh
POST http://localhost:3000/api/v1/refresh
Authorization: Bearer {{token}}

> {%
  client.global.set("token", response.body.token);
%}

### Log out
POST http://localhost:3000/api/v1/logout
Authorization: Bearer {{token}}

### Create task
POST http://localhost:3000/api/v1/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Ship v1",
  "description": "The first release"
}

### Create task with bad data
POST http://localhost:3000/api/v1/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "   ",
  "assigned_to": 99,
  "due_at": "2020-01-01"
}

### Show task
GET http://localhost:3000/api/v1/tasks/1
Authorization: Bearer {{token}}

### List tasks
GET http://localhost:3000/api/v1/tasks?status=pending&per_page=5
Authorization: Bearer {{token}}

### Update task
PATCH http://localhost:3000/api/v1/tasks/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "in-progress"
}

### Delete task
DELETE http://localhost:3000/api/v1/tasks/1
Authorization: Bearer {{token}}

### List users
GET http://localhost:3000/api/v1/users
Authorization: Bearer {{token}}

### Show user
GET http://localhost:3000/api/v1/users/2
Authorization: Bearer {{token}}

### Hello
GET http://localhost:3000/hello
